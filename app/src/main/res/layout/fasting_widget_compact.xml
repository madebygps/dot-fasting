<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_compact"
    android:padding="7dp">

    <ImageView
        android:id="@+id/widget_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_loading"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_timer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/widget_digits"
        android:gravity="center"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/widget_foreground"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_foreground"
        android:textSize="10sp" />
</FrameLayout>
